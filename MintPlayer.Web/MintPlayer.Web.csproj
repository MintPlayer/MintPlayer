<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <SpaRoot>ClientApp\</SpaRoot>
    <!-- Build/serve the nested Angular app via SpaServices. We use MintPlayer's Spark
         prerendering (Phase 1.6), not Angular's own SSR builder, so disable the SSR build path. -->
    <BuildServerSideRenderer>false</BuildServerSideRenderer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MintPlayer.AspNetCore.SpaServices" Version="10.5.0" />
    <PackageReference Include="MintPlayer.SourceGenerators" Version="10.19.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Local Spark clone (C:\Repos\MintPlayer.Spark). Consuming the framework via ProjectReference
       keeps the dev loop tight while app + framework are co-developed; switch to versioned NuGet
       packages at release (see Phase 6).
       NB: a package swap was attempted and reverted — the published feed is currently inconsistent
       (MintPlayer.Spark preview.34 depends on MintPlayer.Spark.Abstractions >= preview.34, but
       Abstractions is only published up to preview.20). Revisit once the framework republishes a
       coherent set. -->
  <ItemGroup>
    <ProjectReference Include="..\MintPlayer.Domain\MintPlayer.Domain.csproj" />
    <ProjectReference Include="..\..\MintPlayer.Spark\libs\spark\MintPlayer.Spark\MintPlayer.Spark.csproj" />
    <ProjectReference Include="..\..\MintPlayer.Spark\libs\authorization\MintPlayer.Spark.Authorization\MintPlayer.Spark.Authorization.csproj" />
    <ProjectReference Include="..\..\MintPlayer.Spark\libs\source_generators\MintPlayer.Spark.SourceGenerators\MintPlayer.Spark.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="App_Data\translations.json" />
    <AdditionalFiles Include="App_Data\Model\*.json" />
  </ItemGroup>

</Project>
