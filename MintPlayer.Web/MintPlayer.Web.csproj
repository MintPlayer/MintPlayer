<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <SpaRoot>ClientApp\</SpaRoot>
    <!-- Build/serve the nested Angular app via SpaServices. We use MintPlayer's Spark
         prerendering (Phase 1.6), not Angular's own SSR builder, so disable the SSR build path. -->
    <BuildServerSideRenderer>false</BuildServerSideRenderer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="MintPlayer.AspNetCore.SpaServices" Version="10.5.0" />
    <PackageReference Include="MintPlayer.SourceGenerators" Version="10.19.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Spark framework via published NuGet packages (coherent preview.35 set — the earlier
       Abstractions publish-skew that forced cross-repo ProjectReference is fixed). Consuming via
       NuGet keeps the build single-context (no Spark source needed), which is what the Docker
       image relies on. The source generators ship as a separate analyzer package; Abstractions is
       pinned on MintPlayer.Domain so app + framework resolve the same assembly. -->
  <ItemGroup>
    <ProjectReference Include="..\MintPlayer.Domain\MintPlayer.Domain.csproj" />
    <PackageReference Include="MintPlayer.Spark" Version="10.0.0-preview.35" />
    <PackageReference Include="MintPlayer.Spark.Authorization" Version="10.0.0-preview.35" />
    <PackageReference Include="MintPlayer.Spark.SourceGenerators" Version="10.0.0-preview.35">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="App_Data\translations.json" />
    <AdditionalFiles Include="App_Data\Model\*.json" />
  </ItemGroup>

</Project>
