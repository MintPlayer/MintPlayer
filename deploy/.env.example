# /var/www/mintplayer/.env — server-managed, never written by deploys. NAMES ONLY here; never commit values.
# Must be LF line endings: a CRLF file poisons every value with an invisible \r.
#
# The public hostnames (mintplayer.com / www) are hardcoded in docker-compose.yml, like every MintPlayer
# deployment. The RavenDB licence is NOT an env var: put the licence JSON in ./raven-license.json next to
# docker-compose.yml (the mintplayer-raven-license one-shot activates it).

# ─── Outgoing mail (mintplayer-smtp, D21) ─────────────────────────────────────
# DKIM private key goes in ./mail-dkim/mintplayer.com.private (flat, owned 101:104); public half in DNS as
# mail._domainkey.mintplayer.com TXT. Add the VPS IPv4 to the mintplayer.com SPF record BEFORE the first send.
#MAIL_FROM_ADDRESS=no-reply@mintplayer.com
#MAIL_FROM_NAME=MintPlayer
#MAIL_DKIM_SELECTOR=mail
# Optional fallback relay (Hetzner blocks outbound 25 until unblocked on request):
#MAIL_RELAY_HOST=
#MAIL_RELAY_USERNAME=
#MAIL_RELAY_PASSWORD=
# Override only to bypass the relay container entirely:
#SMTP_HOST=
#SMTP_PORT=

# ─── RavenDB periodic backup (D23) ────────────────────────────────────────────
# Local backups (hourly incremental + nightly full) to the raven-backups volume are always on in prod.
#RAVEN_BACKUP_RETENTION_DAYS=30
# Optional off-box copy to S3 / S3-compatible storage (e.g. Hetzner Object Storage). Leave the bucket empty
# for local-only. Cloud destinations are license-gated — see docs/spikes/S8-hetzner-deploy/RESULT.md.
#RAVEN_BACKUP_S3_BUCKET=
#RAVEN_BACKUP_S3_FOLDER=mintplayer
#RAVEN_BACKUP_S3_REGION=
#RAVEN_BACKUP_S3_URL=
#RAVEN_BACKUP_S3_FORCE_PATH_STYLE=true
#RAVEN_BACKUP_S3_ACCESS_KEY=
#RAVEN_BACKUP_S3_SECRET_KEY=

# ─── To come with later features (names reserved, not wired yet) ──────────────
# Social logins (D4) and any other secrets are added here when their features land.
